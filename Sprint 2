## Appendix: pattern to copy

This is the Customers "register a new customer" feature (#53) through every layer. Copy it for your own module and change the names.

### Shared helpers (F2, Patryk)

```js
// src/errors.js
function httpError(status, message) {
  const err = new Error(message);
  err.status = status;
  return err;
}

module.exports = { httpError };
```

```js
// src/db.js – one shared connection pool for the whole app
const sql = require('mssql');

const config = {
  server: process.env.DB_HOST,
  database: process.env.DB_NAME,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  options: {
    encrypt: true,
    trustServerCertificate: process.env.DB_TRUST_SERVER_CERT === 'true',
  },
};

let poolPromise;

function getPool() {
  if (!poolPromise) {
    poolPromise = new sql.ConnectionPool(config).connect();
  }
  return poolPromise;
}

module.exports = { sql, getPool };
```

```js
// in src/app.js, after all the routers
app.use((err, req, res, next) => {
  if (err.status) {
    return res.status(err.status).json({ error: err.message });
  }
  console.error(err);
  res.status(500).json({ error: 'Something went wrong' });
});
```

`test_app` already connects to the database, so reuse its existing settings in `db.js`. The point is that there's exactly one pool.

### 1. Route

```js
// src/modules/customers/customers.routes.js
const express = require('express');
const controller = require('./customers.controller');

const router = express.Router();

router.get('/', controller.list);         // GET  /api/customers?search=
router.get('/:id', controller.getById);   // GET  /api/customers/5
router.post('/', controller.create);      // POST /api/customers
router.put('/:id', controller.update);    // PUT  /api/customers/5

module.exports = router;
```

### 2. Controller

```js
// src/modules/customers/customers.controller.js
const service = require('./customers.service');

async function create(req, res, next) {
  try {
    const customer = await service.create(req.body);
    res.status(201).json(customer);
  } catch (err) {
    next(err); // the error handler in app.js turns this into a response
  }
}

module.exports = { create /*, list, getById, update */ };
```

### 3. Service

```js
// src/modules/customers/customers.service.js
const data = require('./customers.data');
const { httpError } = require('../../errors');

async function create(input) {
  if (!input.first_name || !input.last_name) {
    throw httpError(400, 'First and last name are required');
  }
  if (!input.phone && !input.email) {
    throw httpError(400, 'Give a phone number or an email address');
  }
  if (input.first_name.length > 50 || input.last_name.length > 50) {
    throw httpError(400, 'Names must be 50 characters or fewer');
  }
  return data.insert(input);
}

module.exports = { create };
```

### 4. Data access

```js
// src/modules/customers/customers.data.js
const { sql, getPool } = require('../../db');

async function insert(c) {
  const pool = await getPool();
  const result = await pool.request()
    .input('first_name', sql.VarChar(50), c.first_name)
    .input('last_name', sql.VarChar(50), c.last_name)
    .input('email', sql.VarChar(100), c.email || null)
    .input('phone', sql.VarChar(20), c.phone || null)
    .input('address', sql.VarChar(255), c.address || null)
    .query(`
      INSERT INTO Customer (first_name, last_name, email, phone, address)
      OUTPUT INSERTED.*
      VALUES (@first_name, @last_name, @email, @phone, @address)
    `);
  return result.recordset[0];
}

module.exports = { insert };
```

**Never** do this. It is exactly the SQL injection risk on the Security page:

```js
// WRONG – user input glued into the SQL string
pool.request().query(`SELECT * FROM Customer WHERE last_name = '${search}'`);
```

For a search, put the wildcards into the parameter value instead:

```js
.input('search', sql.VarChar(100), `%${search}%`)
.query('SELECT * FROM Customer WHERE last_name LIKE @search OR phone LIKE @search');
```

### 5. Tests

```js
// tests/customers.test.js
const request = require('supertest');
const app = require('../src/app');
const data = require('../src/modules/customers/customers.data');

jest.mock('../src/modules/customers/customers.data'); // no real database

test('POST /api/customers creates a customer', async () => {
  data.insert.mockResolvedValue({ customer_id: 1, first_name: 'Mary', last_name: 'Byrne' });

  const res = await request(app)
    .post('/api/customers')
    .send({ first_name: 'Mary', last_name: 'Byrne', phone: '0870000000' });

  expect(res.status).toBe(201);
  expect(res.body.customer_id).toBe(1);
});

test('POST /api/customers rejects a missing name', async () => {
  const res = await request(app)
    .post('/api/customers')
    .send({ phone: '0870000000' });

  expect(res.status).toBe(400);
  expect(data.insert).not.toHaveBeenCalled();
});
```

### 6. Front end

```js
// public/js/api.js (shared, F5)
async function api(path, options = {}) {
  const res = await fetch(path, {
    method: options.method || 'GET',
    headers: { 'Content-Type': 'application/json' },
    body: options.body ? JSON.stringify(options.body) : undefined,
  });
  const body = await res.json().catch(() => ({}));
  if (!res.ok) {
    throw new Error(body.error || 'Request failed');
  }
  return body;
}
```

```js
// public/js/customers.js
async function saveCustomer() {
  const message = document.getElementById('message');
  try {
    const customer = await api('/api/customers', {
      method: 'POST',
      body: {
        first_name: document.getElementById('first_name').value,
        last_name: document.getElementById('last_name').value,
        phone: document.getElementById('phone').value,
        email: document.getElementById('email').value,
      },
    });
    message.textContent = `Saved ${customer.first_name} ${customer.last_name}`; // textContent, never innerHTML
  } catch (err) {
    message.textContent = err.message; // show the API's error on the page
  }
}
```
